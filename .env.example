# Leave the Supabase vars unset to run on local browser storage (no account needed).
# Set both to switch the whole app over to Supabase — nothing else changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Passcode for the staff panel at #/staff, used in BOTH modes. It is checked in
# the browser, so it keeps casual visitors out of the panel — it does not
# protect the database. See supabase/open-writes.sql.
VITE_ADMIN_PASSCODE=tango

# Restaurant WhatsApp number in full international format, digits only
# (country code first, no +, no spaces). Leave empty to hide the WhatsApp
# button entirely. Cote d'Ivoire numbers are 225 + 10 digits since 2021,
# e.g. 2250701234567 for +225 07 01 23 45 67.
VITE_WHATSAPP_NUMBER=

# Shown in the footer and on the printed carte. All optional.
# e.g. VITE_ADDRESS=San Pédro, Côte d'Ivoire
VITE_ADDRESS=
VITE_PHONE=
VITE_HOURS=
